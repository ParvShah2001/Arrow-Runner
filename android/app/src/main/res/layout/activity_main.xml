<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <!-- Native Hardware Accelerated SurfaceView Canvas -->
    <com.main.arrowrunner.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Gameplay Top HUD Header -->
    <RelativeLayout
        android:id="@+id/hud_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentStart="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCORE"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/hud_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#0288D1"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HIGH"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/hud_high"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#F59E0B"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COINS"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/hud_coins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪙 0"
                    android:textColor="#F59E0B"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_pause"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/rounded_btn_bg"
            android:src="@android:drawable/ic_media_pause"
            android:tint="#0288D1" />
    </RelativeLayout>

    <!-- START / MAIN MENU OVERLAY -->
    <LinearLayout
        android:id="@+id/screen_main_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0090D16"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ARROW RUNNER"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NATIVE ARCADE"
            android:textColor="#0288D1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#E00F172A"
            android:padding="20dp"
            android:elevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/menu_high_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑 HIGH: 0"
                    android:textColor="#F59E0B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="16dp" />
                <TextView
                    android:id="@+id/menu_coins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪙 COINS: 0"
                    android:textColor="#F59E0B"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▶ START GAME"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#10B981"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_open_skins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎨 SKINS SHOP"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0288D1"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_open_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚙️ SETTINGS"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#8B5CF6" />
        </LinearLayout>
    </LinearLayout>

    <!-- SKINS SHOP OVERLAY (4 TABS: Arrow, Hazard, Points, Coins) -->
    <LinearLayout
        android:id="@+id/screen_skins_shop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0090D16"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="SKINS SHOP"
            android:textColor="#0288D1"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shop_coin_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="🪙 YOUR COINS: 0"
            android:textColor="#F59E0B"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- 4 CATEGORY BUTTON TABS -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/tab_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚀 ARROW"
                    android:textSize="12sp"
                    android:backgroundTint="#0288D1"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/tab_hazard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💣 HAZARD"
                    android:textSize="12sp"
                    android:backgroundTint="#475569"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/tab_point"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔮 POINTS"
                    android:textSize="12sp"
                    android:backgroundTint="#475569"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/tab_coin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪙 COINS"
                    android:textSize="12sp"
                    android:backgroundTint="#475569" />
            </LinearLayout>
        </HorizontalScrollView>

        <ListView
            android:id="@+id/skins_list_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_skins_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="◀ MAIN MENU"
            android:backgroundTint="#0288D1" />
    </LinearLayout>

    <!-- SETTINGS OVERLAY (THEME TOGGLE + AUDIO) -->
    <LinearLayout
        android:id="@+id/screen_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0090D16"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textColor="#8B5CF6"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_toggle_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌙 DARK MODE"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F59E0B"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_toggle_mute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔊 SOUND ON"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0288D1"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_settings_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="◀ MAIN MENU"
            android:backgroundTint="#8B5CF6" />
    </LinearLayout>

    <!-- GAME OVER OVERLAY -->
    <LinearLayout
        android:id="@+id/screen_game_over"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0090D16"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_game_over_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAME OVER"
            android:textColor="#EF4444"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_final_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FINAL SCORE: 0"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_coins_earned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COINS EARNED: +0 🪙"
            android:textColor="#F59E0B"
            android:textSize="18sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶ PLAY AGAIN"
            android:backgroundTint="#10B981"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_gameover_mainmenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏠 MAIN MENU"
            android:backgroundTint="#0288D1" />
    </LinearLayout>

</RelativeLayout>
